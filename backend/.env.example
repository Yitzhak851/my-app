# Copy this file to .env and fill in your own values.
# .env is gitignored — NEVER commit real credentials.

# --- Flask ---------------------------------------------------------------
# development | testing | production
FLASK_ENV=development
# True only on your own machine. Never True on a server: the Werkzeug debugger
# allows remote code execution.
FLASK_DEBUG=True
# 127.0.0.1 = local only. Use 0.0.0.0 only behind a real web server (nginx).
HOST=127.0.0.1
PORT=5000

# --- Database (required) -------------------------------------------------
# The MySQL server the API connects to. Create the database with db/schema.sql.
DB_HOST=localhost
DB_USER=root
# REQUIRED. Your own local MySQL password — leave empty if your MySQL has none.
DB_PASSWORD=
DB_NAME=social_app

# --- CORS (required) -----------------------------------------------------
# Comma-separated list of origins allowed to call this API.
# 5173 is the Vite dev server; add your deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Security (required) -------------------------------------------------
# Signs session cookies. MUST be a long random value in production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-value
