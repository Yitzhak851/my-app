# Copy this file to .env and fill in your own values.
# .env is gitignored — NEVER commit real credentials.

# --- Flask ---------------------------------------------------------------
# development | testing | production
FLASK_ENV=development
# True only on your own machine. Never True on a server: the Werkzeug debugger
# allows remote code execution.
FLASK_DEBUG=True
# 127.0.0.1 = local only. Use 0.0.0.0 only behind a real web server (nginx).
HOST=127.0.0.1
PORT=5000

# --- Database (required) -------------------------------------------------
# The MySQL server the API connects to. Create the database with db/schema.sql.
DB_HOST=localhost
DB_USER=root
# REQUIRED. Your own local MySQL password — leave empty if your MySQL has none.
DB_PASSWORD=
DB_NAME=social_app

# --- CORS (required) -----------------------------------------------------
# Comma-separated list of origins allowed to call this API.
# 5173 is the Vite dev server; add your deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Security (required) -------------------------------------------------
# Flask secret. MUST be a long random value in production.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-value

# Session cookie.
# SECURE=True sends the cookie over HTTPS only. Leave False on localhost (plain
# HTTP) and set it True in production — FLASK_ENV=production also forces it on.
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax

# --- Password reset email ------------------------------------------------
# Where the frontend lives — used to build the link inside the reset email.
FRONTEND_URL=http://localhost:5173

# How mail is delivered:
#   console  print it to the server log (default — no mail server needed;
#            the reset link appears right in your terminal)
#   file     append it to MAIL_FILE_PATH
#   smtp     a real server, using the settings below
MAIL_BACKEND=console
MAIL_FROM=no-reply@ybo-social.local

# Only needed when MAIL_BACKEND=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=True
