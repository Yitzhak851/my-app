# Production environment for the API.
#
# Copy to /opt/ybo/backend/.env ON THE SERVER and fill in the real values.
# This file is a template and contains no secrets. The real one never goes into
# git — it holds the database password and the signing key.
#
#     sudo -u ybo cp deploy/env.production.example /opt/ybo/backend/.env
#     sudo -u ybo nano /opt/ybo/backend/.env
#     sudo chmod 600 /opt/ybo/backend/.env
#
# run.py refuses to start in production while SECRET_KEY is still a placeholder,
# DB_PASSWORD is empty, or FLASK_DEBUG is on.

# --- Flask ---------------------------------------------------------------
FLASK_ENV=production

# Never anything else here. FLASK_DEBUG=True in production is the Werkzeug
# interactive debugger, which lets anyone who can reach the port run code.
FLASK_DEBUG=False

# gunicorn binds this; only nginx connects to it. Do not put 0.0.0.0 here —
# that publishes the API on the internet with the proxy bypassed.
HOST=127.0.0.1
PORT=5000

# --- Database (required) -------------------------------------------------
# localhost for MySQL on the same instance, or the RDS endpoint.
DB_HOST=localhost
DB_USER=ybo
DB_PASSWORD=
DB_NAME=social_app

# --- Security (required) -------------------------------------------------
# Generate a fresh one for this server. Do not reuse the development value:
# anyone who has read the repository knows it.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# The frontend is served from the same origin by nginx, so the API is never
# called cross-origin and CORS does not apply. This stays set to the real
# origin anyway: if something ever does call it from elsewhere, the list should
# be right rather than absent.
CORS_ORIGINS=https://your-domain.example.com

# Send the session cookie over HTTPS only. Leave this True.
#
# The failure mode when there is no HTTPS is genuinely confusing: the browser
# accepts the login response, silently discards the cookie because the
# connection is not secure, and every following request is anonymous. The log
# shows 200s. The screen says you are signed out. Run certbot before opening
# the site to anyone.
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax

# nginx sets X-Forwarded-*; the app reads them for the real client address and
# the real scheme. Only True when there really is a proxy in front.
TRUST_PROXY_HEADERS=True

# --- Password reset email ------------------------------------------------
FRONTEND_URL=https://your-domain.example.com

# 'console' writes the reset link to the service log, which is enough to
# demonstrate the flow: journalctl -u ybo-api -f
# Switch to 'smtp' and fill in the block below to send real mail.
MAIL_BACKEND=console
MAIL_FROM=no-reply@your-domain.example.com

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=True

# --- AI and the agents ---------------------------------------------------
# Local: no API key, no network calls, no cost.
AI_PROVIDER=local

# Left False here on purpose. The agents run as their own service
# (ybo-agents.service), which sets it True for itself. If the API workers had
# it on, each one would run its own scheduler.
AGENTS_ENABLED=False
AGENT_TICK_SECONDS=120

# --- gunicorn ------------------------------------------------------------
# workers × threads must stay at or under the MySQL pool size (10, set in
# app/utils/db.py) or requests queue on the pool instead of on the database.
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
